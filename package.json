{
  "name": "math-data-science-academy",
  "productName": "Math Data Science Academy",
  "version": "1.0.0",
  "description": "آکادمی ریاضی و علم داده — آموزش ریاضی از صفر تا علم داده با حل‌گر گام‌به‌گام، ابزارهای تعاملی و دفترچهٔ پایتون",
  "author": "ebixs <ebrahimsalimi123@gmail.com>",
  "homepage": "https://github.com/ebixs/math-data-science-academy",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/engine.test.js && node tests/desktop.test.js",
    "pyodide": "node desktop/fetch-pyodide.mjs",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.ebixs.mathacademy",
    "productName": "Math Data Science Academy",
    "copyright": "© ebixs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "build/icon.png",
      "index.html",
      "solver.html",
      "math-tools.html",
      "python.html",
      "manifest.webmanifest",
      "sw.js",
      "assets/**",
      "chapters/**",
      "README.md",
      "CURRICULUM.md",
      "SOURCES.md",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "title": "Math Data Science Academy",
      "artifactName": "Math-Data-Science-Academy-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Math Data Science Academy",
      "artifactName": "Math-Data-Science-Academy-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
